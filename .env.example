# URL the manual Sync button POSTs unsynced entries to.
# Leave unset until a real sync server exists — the app works fully offline without it.
# VITE_SYNC_URL=https://example.com/api/sync

# Google Gemini API key for the optional "Estimate" button (calorie estimate from
# the description). Free tier — no billing. Get one at https://aistudio.google.com.
# Restrict it to your site (HTTP referrers) in the Google Cloud console.
# Unset -> the Estimate button is hidden and logging works as normal.
# VITE_GEMINI_API_KEY=your-key-here
# VITE_GEMINI_MODEL=gemini-2.0-flash
